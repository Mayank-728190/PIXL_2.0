# ==============================================================================
# PIXL 2.0 Environment Configuration
# ==============================================================================

# Environment mode: development, staging, production
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security Secrets (Must be rotated and 32+ cryptographically random bytes in production)
SECRET_KEY=pixl_dev_secret_key_change_me_in_production_89432f8a1e2049b
SESSION_COOKIE_NAME=__Host-PIXL-Session
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=1209600 # 14 days

# Master Super-Admin Origin & Settings
MASTER_ORIGIN=http://master.pixl.local:3000
AGENCY_ORIGIN=http://agency.pixl.local:3000
ADVERTISER_ORIGIN=http://advertiser.pixl.local:3000

# Database Settings (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pixl2_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_TIMEOUT_SECONDS=30

# Redis 7 (Cache, Presence, Rate Limiting, Celery Broker)
REDIS_URL=redis://localhost:6379/0

# Asymmetric ED25519 Signing Key for Manifests (Base64-encoded private key)
# Generated dynamically if empty in development
MANIFEST_SIGNING_PRIVATE_KEY_B64=
MANIFEST_SIGNING_PUBLIC_KEY_B64=

# Storage Settings (Cloudflare R2 / S3-compatible)
STORAGE_PROVIDER=local # 'local' for dev without cloud credentials, 'r2' for production
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_QUARANTINE=pixl-quarantine-dev
R2_BUCKET_PUBLISHED=pixl-published-dev
R2_PUBLIC_URL_PREFIX=https://media.pixl.local

# Device Enrollment Settings
ENROLLMENT_PIN_TTL_SECONDS=900 # 15 minutes
ENROLLMENT_MAX_ATTEMPTS=5
DEVICE_HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_OFFLINE_THRESHOLD_SECONDS=180

# Celery Background Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

